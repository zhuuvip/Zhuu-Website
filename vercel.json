{
  "version": 2,
  "buildCommand": "pnpm tsc --build && pnpm --filter @workspace/zhuu-vip run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "artifacts/zhuu-vip/dist"
}
